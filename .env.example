# Autopilot Console — Environment Configuration
# Copy to .env and replace placeholder values before running docker compose up.

# --- Database ---
POSTGRES_DB=autopilot
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=change-me-use-a-strong-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://autopilot:change-me-use-a-strong-password@postgres:5432/autopilot

# --- Authentication ---
# Must be at least 16 characters
SESSION_SECRET=change-me-at-least-16-chars-long

# --- Admin Bootstrap ---
# Must be at least 12 characters with upper, lower, digit, and special char
ADMIN_BOOTSTRAP_PASSWORD=Change-Me-123!

# --- Workspace ---
# Comma-separated list of allowed workspace root paths inside the worker container
WORKSPACE_ROOTS=/projects
# Host path to mount as the projects workspace (absolute or relative to compose.yaml)
WORKSPACE_MOUNT=./projects

# --- Worker ---
MAX_CONCURRENT_JOBS=4
AUTOPILOTAGENT_MOUNT=/absolute/path/to/autopilotagent
AUTOPILOTAGENT_BIN=/opt/autopilotagent/run.sh
# Required agent CLI used by autopilotagent (must be executable inside the worker)
AGENT_BIN=cmd
# Bounded diagnostic file root (Compose mounts diagnostic-logs here)
DIAGNOSTIC_LOG_DIR=/app/logs
# Internal-only worker health probe port (not published to the host)
WORKER_HEALTH_PORT=3001

# --- GitHub ---
# Required for GitHub API operations (PR creation, CI polling)
# Generate at https://github.com/settings/tokens with repo scope
GH_TOKEN=your-github-token-here
GITHUB_TOKEN=your-github-token-here
GITHUB_POLL_INTERVAL_SECONDS=60

# --- Ports (optional, defaults shown) ---
WEB_PORT=80
API_PORT=3000
POSTGRES_PORT=5432
